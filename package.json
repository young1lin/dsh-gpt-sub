{
  "name": "@young1lin/dsh-gpt-sub",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Direct ChatGPT/Codex subscription access for DeepSeek Harness, replacing CLIProxyAPI.",
  "author": "young1lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/young1lin/dsh-gpt-sub.git"
  },
  "homepage": "https://github.com/young1lin/dsh-gpt-sub#readme",
  "bugs": "https://github.com/young1lin/dsh-gpt-sub/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "chatgpt",
    "codex",
    "openai",
    "subscription",
    "quota"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "undici": "^7.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
